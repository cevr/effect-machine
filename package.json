{
  "name": "effect-machine",
  "version": "0.18.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cevr/effect-machine.git"
  },
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./cluster": {
      "import": {
        "types": "./dist/cluster/index.d.ts",
        "default": "./dist/cluster/index.js"
      }
    },
    "./atom": {
      "import": {
        "types": "./dist/atom.d.ts",
        "default": "./dist/atom.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test --tsconfig-override=tsconfig.json",
    "test:watch": "bun test --watch",
    "example:react": "bun run --filter effect-machine-example-react dev",
    "example:solid": "bun run --filter effect-machine-example-solid dev",
    "examples:gate": "bun run --filter effect-machine-example-react gate && bun run --filter effect-machine-example-solid gate",
    "bench": "bun benchmark/core.ts",
    "gate": "concurrently -n type,lint,fmt,test,build,examples -c blue,yellow,magenta,green,cyan,white \"bun run typecheck\" \"bun run lint:fix\" \"bun run fmt\" \"bun run test\" \"bun run build\" \"bun run examples:gate\"",
    "prepare": "lefthook install && effect-tsgo patch",
    "version": "changeset version",
    "build": "bun --bun tsdown",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@effect/tsgo": "0.38.0",
    "@types/bun": "1.4.0",
    "concurrently": "10.0.5",
    "effect": "4.0.0-rc.112",
    "effect-bun-test": "0.3.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-plugin-effect": "0.11.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112 <5"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": false
    }
  }
}
